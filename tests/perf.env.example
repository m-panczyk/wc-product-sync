# Perf-test rig endpoints/secrets. Copy to tests/perf.env and fill in.
# tests/perf.env is gitignored; never commit real values.
QNAP_SSH="YOUR_QNAP_SSH"                  # e.g. user@host
QNAP_DOCKER="/path/to/docker"             # path to docker binary on the QNAP
QNAP_PROJECT="/share/ZFS18_DATA/Container/wps-test-src"
GRAFANA="http://YOUR_GRAFANA_HOST:3000"
GRAFANA_TOKEN="YOUR_GRAFANA_TOKEN_HERE"
INFLUX="http://YOUR_INFLUX_HOST:8086"
INFLUX_ORG="YOUR_INFLUX_ORG"
INFLUX_TOKEN="YOUR_INFLUX_TOKEN_HERE"

# Source (mutation target) — REST keys are read-only, so price changes go via wp-cli over root SSH.
SRC_SSH="YOUR_SRC_SSH"                    # e.g. root@host
SRC_CONTAINER="wps-source-cli-1"          # wp-cli container name on source host
SRC_PROJECT="/opt/wps-source"             # compose project dir on the source host
